---
import { galleryData } from '../data/galleryData';
const featuredItems = galleryData.filter(item => item.featured).slice(0, 4);
---

<section id="featured" class="featured-section">
  <div class="container">
    <div class="section-header">
      <div>
        <span class="section-tag">Colección Seleccionada</span>
        <h2 class="section-title">Obras Destacadas</h2>
      </div>
      <a href="/gallery" class="view-all-link">
        Ver Galería Completa ({galleryData.length}) &rarr;
      </a>
    </div>

    <div class="featured-grid">
      {featuredItems.map((art) => (
        <article class="art-card">
          <div class="card-image-wrapper">
            <img 
              src={art.image} 
              alt={art.title} 
              loading="lazy" 
            />
            <span class="category-badge">{art.category}</span>
          </div>

          <div class="card-content">
            <div class="card-meta">
              <span class="artist-name">{art.artist}</span>
              <span class="art-year">{art.year}</span>
            </div>
            <h3 class="art-title">{art.title}</h3>
            <p class="art-medium">{art.medium}</p>

            <a href={`/gallery?id=${art.id}`} class="card-link" aria-label={`Ver detalles de ${art.title}`}>
              <span>Ver Obra</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .featured-section {
    padding: 5rem 0;
    background: var(--bg-secondary);
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
    transition: background var(--transition-normal);
  }

  .section-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 3rem;
  }

  @media (min-width: 768px) {
    .section-header {
      flex-direction: row;
      align-items: flex-end;
    }
  }

  .section-tag {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    display: block;
    margin-bottom: 0.4rem;
  }

  .section-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .view-all-link {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--text-primary);
    transition: opacity var(--transition-fast);
  }

  .view-all-link:hover {
    opacity: 0.7;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 640px) {
    .featured-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .featured-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .art-card {
    background: var(--bg-surface);
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border-color);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-normal), box-shadow var(--transition-normal), border-color var(--transition-normal);
  }

  .art-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-md);
    border-color: var(--border-hover);
  }

  .card-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--bg-secondary);
  }

  .card-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .art-card:hover .card-image-wrapper img {
    transform: scale(1.06);
  }

  .category-badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background: var(--bg-glass);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-primary);
    border: 1px solid var(--border-color);
  }

  .card-content {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 0.4rem;
  }

  .artist-name {
    font-weight: 500;
  }

  .art-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.3rem;
  }

  .art-medium {
    font-size: 0.82rem;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-link {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-color);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
    transition: opacity var(--transition-fast);
  }

  .card-link:hover {
    opacity: 0.75;
  }
</style>
