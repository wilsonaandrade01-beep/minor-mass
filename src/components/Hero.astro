---
import { galleryData } from '../data/galleryData';
const featuredCount = galleryData.filter(item => item.featured).length;
const totalCount = galleryData.length;
---

<section class="hero-section">
  <div class="container hero-container">
    <div class="hero-content animate-fade-in">
      <div class="badge">
        <span class="badge-dot"></span> Exposición Estática 2026
      </div>

      <h1 class="hero-title">
        Donde la forma y la <span class="highlight">luz</span> convergen.
      </h1>

      <p class="hero-subtitle">
        Una selección exclusiva de obras visuales, fotografía de autor y arte digital contemporáneo presentada en una experiencia pura, rápida y minimalista.
      </p>

      <div class="hero-actions">
        <a href="/gallery" class="btn-hero-primary">
          Explorar la Galería
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>

        <a href="#featured" class="btn-hero-secondary">
          Ver Destacadas
        </a>
      </div>

      <div class="hero-stats">
        <div class="stat-item">
          <span class="stat-number">{totalCount}</span>
          <span class="stat-label">Obras de Arte</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-number">5</span>
          <span class="stat-label">Disciplinas</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-number">{featuredCount}</span>
          <span class="stat-label">Piezas Maestras</span>
        </div>
      </div>
    </div>

    <div class="hero-visual">
      <div class="visual-card main-art">
        <img 
          src="https://images.unsplash.com/photo-1579783902614-a3fb3927b675?q=80&w=1000&auto=format&fit=crop" 
          alt="Sinfonía Estelar" 
          loading="eager"
        />
        <div class="art-caption glass">
          <span class="caption-title">Sinfonía Estelar</span>
          <span class="caption-artist">Elena Rostova • Óleo sobre lienzo</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding: 4rem 0 3rem 0;
    position: relative;
    overflow: hidden;
  }

  @media (min-width: 992px) {
    .hero-section {
      padding: 6rem 0 4rem 0;
    }
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  @media (min-width: 992px) {
    .hero-container {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background-color: var(--accent-gold);
    border-radius: 50%;
    display: inline-block;
  }

  .hero-title {
    font-size: 2.75rem;
    font-weight: 800;
    line-height: 1.08;
    margin: 1.2rem 0;
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: 3.75rem;
    }
  }

  .highlight {
    background: linear-gradient(135deg, var(--text-primary) 30%, var(--text-muted) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    font-size: 1.1rem;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 540px;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 3rem;
  }

  .btn-hero-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1.75rem;
    background: var(--text-primary);
    color: var(--bg-primary);
    border-radius: var(--radius-full);
    font-weight: 600;
    font-size: 0.95rem;
    transition: transform var(--transition-fast), opacity var(--transition-fast), box-shadow var(--transition-fast);
    box-shadow: var(--shadow-md);
  }

  .btn-hero-primary:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  .btn-hero-secondary {
    display: inline-flex;
    align-items: center;
    padding: 0.85rem 1.75rem;
    background: var(--bg-secondary);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-full);
    font-weight: 600;
    font-size: 0.95rem;
    transition: border-color var(--transition-fast), background var(--transition-fast);
  }

  .btn-hero-secondary:hover {
    border-color: var(--border-hover);
    background: var(--bg-surface);
  }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-color);
  }

  .stat-item {
    display: flex;
    flex-direction: column;
  }

  .stat-number {
    font-family: 'Outfit', sans-serif;
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .stat-label {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .stat-divider {
    width: 1px;
    height: 36px;
    background-color: var(--border-color);
  }

  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .visual-card {
    position: relative;
    width: 100%;
    max-width: 480px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--border-color);
    transition: transform var(--transition-normal);
  }

  .visual-card:hover {
    transform: scale(1.02);
  }

  .visual-card img {
    width: 100%;
    height: 420px;
    object-fit: cover;
  }

  .art-caption {
    position: absolute;
    bottom: 1.25rem;
    left: 1.25rem;
    right: 1.25rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .caption-title {
    font-weight: 700;
    font-size: 1rem;
    color: var(--text-primary);
  }

  .caption-artist {
    font-size: 0.8rem;
    color: var(--text-secondary);
  }
</style>
